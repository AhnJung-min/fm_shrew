<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FM26 안에서 도는 BepInEx 6 (IL2CPP) 플러그인.
    게임과 BepInEx가 설치된 폴더의 어셈블리를 그대로 참조한다(따로 내려받는 것은 .NET 6 참조 팩뿐이다).
    게임 폴더가 기본 위치가 아니면:  dotnet build -p:GameDir="D:\...\Football Manager 26"
    빌드한 뒤 게임 폴더에 넣으려면:  dotnet build -c Release -p:Deploy=true
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FmBojwagwanBridge</AssemblyName>
    <RootNamespace>FmBojwagwan.Bridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- 참조하는 게임 쪽 어셈블리에 NullableAttribute가 다른 모양으로 들어 있어 null 검사 주석을 켤 수 없다 -->
    <Nullable>disable</Nullable>
    
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Football Manager 26</GameDir>
    <PluginDir>$(GameDir)\BepInEx\plugins\FmBojwagwanBridge</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <GameReference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" />
    <GameReference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" />
    <GameReference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" />
    <GameReference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll" />
    <GameReference Include="$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll" />
    <GameReference Include="$(GameDir)\BepInEx\interop\Il2CppSystem.dll" />
    <GameReference Include="$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll" />
    <GameReference Include="$(GameDir)\BepInEx\interop\UnityEngine.UIElementsModule.dll" />
    <GameReference Include="$(GameDir)\BepInEx\interop\UnityEngine.IMGUIModule.dll" />
    <GameReference Include="$(GameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll" />
    <GameReference Include="$(GameDir)\BepInEx\interop\UnityEngine.TextCoreTextEngineModule.dll" />
    <GameReference Include="$(GameDir)\BepInEx\interop\UnityEngine.InputLegacyModule.dll" />
    <GameReference Include="$(GameDir)\BepInEx\interop\Unity.InputSystem.dll" />
    <!-- 게임의 데이터 나무(화면에 값을 넣어 주는 통로) -->
    <GameReference Include="$(GameDir)\BepInEx\interop\SI.Core.dll" />
    <GameReference Include="$(GameDir)\BepInEx\interop\SI.Bindable.dll" />
    <GameReference Include="$(GameDir)\BepInEx\interop\SI.Bindable.Reference.Core.dll" />
    <GameReference Include="$(GameDir)\BepInEx\interop\SI.UI.dll" />
    <Reference Include="@(GameReference)" Private="false" />
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameDir)\BepInEx\core\BepInEx.Core.dll')"
           Text="BepInEx가 설치된 게임 폴더를 찾지 못했습니다: $(GameDir)  (-p:GameDir=... 로 알려 주세요)" />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <Message Importance="high" Text="게임 폴더에 넣었습니다: $(PluginDir)" />
  </Target>

</Project>
